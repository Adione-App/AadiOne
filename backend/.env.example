
NODE_ENV=development           
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=debug                     



DATABASE_URL=postgresql://postgres:admin@localhost:5432/adione


REDIS=false
REDIS_URL=redis://localhost:6379

ALLOW_MEMORY_CACHE_IN_PRODUCTION=false


JWT_SECRET=change-me-min-32-chars-long-random-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30


OTP_PEPPER=change-me-min-32-chars-long-random-pepper-value
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30


CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://adione.in,https://www.adione.in


OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=


PAYMENT_PROVIDER=upi_intent


UPI_VPA=oslokutiya@ybl
UPI_PAYEE_NAME=AdiOne




NOTIFICATION_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=


# Development: local disk (served at /static). Production (V2) refuses local:
#   STORAGE_PROVIDER=s3
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_BUCKET=<public image bucket — V2's own, never V1's>
#   S3_PRIVATE_BUCKET=<separate private bucket for seller documents>
#   STORAGE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<S3_BUCKET>
# Images stored before switching keep their old URLs; moving them is a
# separate migration.
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/static
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# Private bucket for seller documents (PDFs). Must NOT be public.
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Uploaded images are stored as resized WebP. "false" attaches them as sent.
IMAGE_OPTIMIZE=true

SEARCH_PROVIDER=postgres


ADMIN_EMAIL=owner@adione.in
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Store Owner













# ---- Docker compose (only read by docker-compose.yml) -----------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=adione


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Payments (PAYMENT_PROVIDER=cashfree). Backend-only — never in the app.
# CASHFREE_ENV: sandbox everywhere except NODE_ENV=production (enforced).
# CASHFREE_API_VERSION: blank = pinned default (2026-01-01).
# Webhook: set in the Cashfree dashboard to <public API base>/api/v1/payments/webhook
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=