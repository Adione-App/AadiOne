# Test environment - the ONLY configuration the test suite reads.
#
# Committed on purpose (backend/.gitignore makes a single exception for this
# file): every value below is a dummy or local-only value, and every developer
# and CI run needs the identical test setup. NEVER put a real credential,
# production URL or production database here; tests/test-env.ts refuses to run
# if one appears.
#
# tests/test-env.ts loads this file and never backend/.env (which holds real
# service credentials). A variable already set on the command line or in CI
# wins over this file, e.g.:
#   DATABASE_URL=postgresql://postgres@localhost:5432/adione_test   (another local cluster)
#   REDIS=true REDIS_URL=redis://:pw@127.0.0.1:6390                  (an isolated local Redis)
#   TEST_SERVICE_HOSTS=postgres,redis                                (CI service containers)
#
# The database is deliberately a different one from development: the suite
# truncates tables between tests, and pointing it at `adione` would wipe the
# developer's seeded catalogue on every run.

NODE_ENV=test
PORT=4001
LOG_LEVEL=silent

# Disposable local test cluster on port 55432 (trust auth, no password).
DATABASE_URL=postgresql://postgres@localhost:55432/adione_test

# In-process cache: each test run gets a clean, isolated store with no external
# dependency and no cross-run bleed.
REDIS=false

JWT_SECRET=test-only-jwt-secret-value-not-used-anywhere-else-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_PEPPER=test-only-otp-pepper-value-not-used-anywhere-else-0123456789
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=1

CORS_ORIGINS=http://localhost:5173

# Every external service on its test stand-in (required by tests/test-env.ts).
OTP_PROVIDER=console
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=console
EMAIL_PROVIDER=console
STORAGE_PROVIDER=local
SEARCH_PROVIDER=postgres

ADMIN_EMAIL=owner@adione.test
ADMIN_PASSWORD=TestAdmin@123
ADMIN_NAME=Test Owner
