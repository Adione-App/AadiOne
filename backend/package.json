{
  "name": "adione-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AdiOne backend API — the sole authority for price, stock, COD and serviceability",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate --schema=prisma-v2/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema=prisma-v2/schema.prisma && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "sync:shared": "node scripts/sync-shared.mjs",
    "report:missing-images": "tsx scripts/report-missing-images.ts",
    "images:optimize": "node scripts/assert-v2-database.mjs && tsx scripts/optimize-images.ts",
    "images:optimize:v2": "node scripts/with-env.mjs .env.v2 node scripts/assert-v2-database.mjs && node scripts/with-env.mjs .env.v2 tsx scripts/optimize-images.ts",
    "db:generate": "prisma generate --schema=prisma-v2/schema.prisma",
    "db:migrate": "node scripts/assert-v2-database.mjs && prisma migrate dev --schema=prisma-v2/schema.prisma",
    "db:migrate:deploy": "node scripts/assert-v2-database.mjs && prisma migrate deploy --schema=prisma-v2/schema.prisma",
    "db:push": "node scripts/assert-v2-database.mjs && prisma db push --schema=prisma-v2/schema.prisma",
    "db:studio": "prisma studio --schema=prisma-v2/schema.prisma",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "node scripts/assert-v2-database.mjs && prisma migrate reset --force --schema=prisma-v2/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev:v2": "prisma generate --schema=prisma-v2/schema.prisma",
    "dev:v2": "node scripts/with-env.mjs .env.v2 tsx watch src/server.ts",
    "db:generate:v2": "node scripts/with-env.mjs .env.v2 prisma generate --schema=prisma-v2/schema.prisma",
    "db:migrate:v2": "node scripts/with-env.mjs .env.v2 node scripts/assert-v2-database.mjs && node scripts/with-env.mjs .env.v2 prisma migrate dev --schema=prisma-v2/schema.prisma",
    "db:migrate:deploy:v2": "node scripts/with-env.mjs .env.v2 node scripts/assert-v2-database.mjs && node scripts/with-env.mjs .env.v2 prisma migrate deploy --schema=prisma-v2/schema.prisma",
    "db:push:v2": "node scripts/with-env.mjs .env.v2 node scripts/assert-v2-database.mjs && node scripts/with-env.mjs .env.v2 prisma db push --schema=prisma-v2/schema.prisma",
    "db:studio:v2": "node scripts/with-env.mjs .env.v2 prisma studio --schema=prisma-v2/schema.prisma",
    "db:seed:v2": "node scripts/with-env.mjs .env.v2 tsx prisma/seed/index.ts"
  },
  "prisma": {
    "schema": "prisma-v2/schema.prisma",
    "seed": "tsx prisma/seed/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
