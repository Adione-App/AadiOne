// =============================================================================
// AdiOne V2 — PostgreSQL schema (multi-seller marketplace)
// =============================================================================
//
// This is the V2 redesign of the V1 single-store schema, and the only active
// schema: every Prisma command uses this file and prisma/migrations (see
// prisma/README.md). The V1 schema and history are archived, read-only, in
// prisma-v1-archive/ — never generated, migrated or deployed. The
// fundamental shift: AdiOne is now a MARKETPLACE. AdiOne's own Grocery is one
// Seller among many (`isPlatformOwned = true`), not a special case baked into
// the schema.
//
// Conventions carried over from V1 (see docs/01-PRD-and-Architecture.md §8):
//
//  1. MONEY is an integer number of paise, stored as Int.
//  2. COORDINATES are Float (double precision).
//  3. ORDERS ARE IMMUTABLE SNAPSHOTS — with ONE deliberate exception in V2:
//     `Order.currentPayablePaise` (see its own doc comment). Every other
//     money/detail field on Order/SellerOrder/OrderItem is written once at
//     creation and never rewritten.
//  4. EVERYTHING IS SELLER-SCOPED from V2 day one — the same reasoning V1
//     applied to "store-scoped," generalized: a category, a listing, a
//     sub-order all know which seller they belong to.
//  5. SOFT DELETE (deleted_at) for anything an order can reference; hard
//     delete for the rest. Partial indexes exclude deleted rows.
//  6. TIMESTAMPS are timestamptz, stored UTC.
//
// NEW V2 architectural rules:
//
//  7. MASTER PRODUCT + SELLER LISTING. `Product`/`ProductVariant` are the
//     shared, seller-agnostic catalog. `SellerListing` (V1: StoreVariant) is
//     where a specific seller's price/stock for a variant lives — the same
//     master variant can have many SellerListing rows, one per seller.
//  8. PARENT ORDER + SELLER ORDER. `Order` is the customer-facing envelope
//     (one payment, one address, one delivery run, aggregate totals).
//     `SellerOrder` is where V1's `Order` semantics (items, status
//     lifecycle, cancellation) actually live now — one per seller involved
//     in that checkout. A customer's single mixed cart can therefore split
//     into several SellerOrders under one Order.
//  9. COMMISSION resolves most-specific-wins, the same shape as the existing
//     CodPolicy INHERIT chain: product > category > seller default.
//     Resolved once at order creation and snapshotted onto SellerOrder —
//     never recomputed later from a possibly-changed rule.
//
// Indexes carry a comment naming the query they serve. An index without a
// query is write cost for nothing.
//
// Constructs Prisma cannot express in this file — partial indexes, CHECK
// constraints, the full-text search trigger, the pg_trgm extension — are
// applied by hand-written V2 migrations (prisma/migrations/*_v2_hardening
// and *_v2_product_search), which are part of the migration history and
// therefore run everywhere.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums — mirrored exactly in backend/src/shared/enums.ts
// =============================================================================

enum UserRole {
  CUSTOMER
  ADMIN
  SELLER_OWNER
  SUPER_ADMIN
  SELLER_MANAGER
  DELIVERY_AGENT
  STAFF
  PHARMACIST
  RESTAURANT_MANAGER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum CatalogVertical {
  GROCERY
  VEGETABLES
  FRUITS
  DAIRY
  CAFE
  FOOD
  PHARMACY
  CLOTHING
  ELECTRONICS
  HOUSEHOLD
  OTHER
}

/// A broad business classification of a Seller — nothing more. It does NOT
/// decide the seller's categories: every seller creates its own categories
/// and subcategories in the Seller Panel. RESTAURANT is the one type with
/// its own behaviour (menu sections, /restaurants). Distinct from
/// `CatalogVertical` (which describes a category's vertical).
enum SellerType {
  GROCERY
  FASHION
  ELECTRONICS
  BEAUTY
  HOME
  PHARMACY
  RESTAURANT
  /// A cafe — a FOOD seller like RESTAURANT: menu sections + food items,
  /// no MRP and no stock count (see SellerListing.tracksStock).
  CAFE
  SPORTS
  BOOKS
  KIDS
  AUTOMOTIVE
  PETS
  SERVICES
  OTHER
}

/// The two-gate seller lifecycle (see Seller.lifecycleStatus). Gate 1 is the
/// admin decision on a seller's APPLICATION; Gate 2 the admin verification of
/// the completed ONBOARDING. Only ACTIVE sellers get the operational Seller
/// Panel — enforced server-side by middleware/sellerLifecycle.ts.
enum SellerLifecycleStatus {
  /// Self-signup received; waiting for admin Gate 1.
  APPLICATION_PENDING
  /// Gate 1 refused. Terminal: no onboarding access.
  APPLICATION_REJECTED
  /// Gate 1 approved (or created by admin): the seller fills in onboarding.
  ONBOARDING_PENDING
  /// Submitted for verification; locked for edits while admin reviews.
  ONBOARDING_PENDING_REVIEW
  /// Admin asked for corrections; the seller edits and resubmits.
  ONBOARDING_CHANGES_REQUIRED
  /// Gate 2 approved — full Seller Panel. Mirrors onboardingStatus APPROVED.
  ACTIVE
  /// Gate 2 refused. Terminal.
  ONBOARDING_REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Shared by Seller onboarding, Product catalog submissions and
/// ProductApprovalBatch(Item) — the same three-state admin review outcome
/// used everywhere admin has to approve something a seller submitted.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// SellerDocument's own verification outcome — kept as a separate enum from
/// ApprovalStatus (rather than reused) so admin-UI copy for "verify a
/// document" and "approve a product" can diverge without becoming
/// confusable in code (`DocumentStatus.VERIFIED` vs `ApprovalStatus.APPROVED`
/// read very differently even though the shape is identical).
enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SellerDocumentType {
  GST_CERTIFICATE
  FSSAI_LICENSE
  PAN_CARD
  AADHAAR_CARD
  BUSINESS_LICENSE
  BANK_PROOF
  OTHER
}

enum SellerStaffRole {
  OWNER
  MANAGER
  STAFF
}

enum UnitType {
  G
  KG
  ML
  L
  PIECE
  PACK
  DOZEN
  BUNDLE
}

/// Three-state COD policy. INHERIT defers to the next level outward:
/// sellerListing -> productVariant -> product -> category(leaf..root) ->
/// seller -> DEFAULT_COD_POLICY config. Most restrictive wins at order level.
enum CodPolicy {
  ALLOW
  DENY
  INHERIT
}

/// Parent-order (customer-facing) lifecycle. Deliberately coarser than
/// SellerOrderStatus below — the customer sees "Processing" while any
/// SellerOrder is still NEW/ACCEPTED/PREPARING, and the delivery-leg states
/// (PICKED_UP onward) only start once every REQUIRED SellerOrder has reached
/// READY_FOR_PICKUP.
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  /// Some, but not all, SellerOrders were cancelled/rejected — the rest of
  /// the order is still proceeding. See Order.currentPayablePaise.
  PARTIALLY_CANCELLED
  /// Every SellerOrder was cancelled/rejected, or the customer cancelled
  /// before any seller accepted.
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Seller-order (per-seller) lifecycle — exactly the states one seller's
/// portion of an order moves through, independent of every other seller's
/// portion of the same parent Order.
enum SellerOrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  ONLINE
  COD
}

/// Money view of an order.
enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// State of one provider interaction.
enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ActorType {
  CUSTOMER
  ADMIN
  SELLER
  DELIVERY_AGENT
  SYSTEM
  PAYMENT_WEBHOOK
}

enum CancelledBy {
  CUSTOMER
  ADMIN
  SELLER
  SYSTEM
}

enum StockLedgerReason {
  PURCHASE
  MANUAL_ADJUST
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_COMMIT
  ORDER_CANCEL_RESTOCK
  DAMAGE
  EXPIRY
  RETURN
}

/// V1: DeliveryAssignmentStatus. Renamed alongside DeliveryAssignment ->
/// DeliveryTask for naming consistency; values unchanged.
enum DeliveryTaskStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  ORDER_READY
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_FAILED
  PAYMENT_SUCCESS
  REFUND_INITIATED
  REFUND_COMPLETED
  BACK_IN_STOCK
  // --- seller-facing (audience SELLER) ---
  SELLER_NEW_ORDER
  SELLER_ORDER_CANCELLED
  SELLER_ORDER_UPDATE
  SELLER_REFUND_ISSUED
  SELLER_ONBOARDING_APPROVED
  SELLER_ONBOARDING_REJECTED
  SELLER_PRODUCT_APPROVED
  SELLER_PRODUCT_REJECTED
  SELLER_SETTLEMENT_CREATED
  SELLER_SETTLEMENT_PROCESSING
  SELLER_SETTLEMENT_PAID
  SELLER_SETTLEMENT_FAILED
  SELLER_APPLICATION_APPROVED
  SELLER_APPLICATION_REJECTED
  SELLER_ONBOARDING_CHANGES_REQUESTED
  // --- admin-facing (audience ADMIN) ---
  ADMIN_ONBOARDING_SUBMITTED
  ADMIN_SELLER_APPLICATION_SUBMITTED
  ADMIN_PRODUCTS_SUBMITTED
  ADMIN_REFUND_FAILED
  ADMIN_SETTLEMENT_FAILED
}

/// Which feed a notification belongs to. A seller's staff user is also a
/// shopper (same login), so the customer app and the seller panel must never
/// show each other's notifications.
enum NotificationAudience {
  CUSTOMER
  SELLER
  ADMIN
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum CouponType {
  PERCENT
  FLAT
  FREE_DELIVERY
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

/// What a login session may do — decided by HOW it was opened, not by the
/// account's role. A customer-app (mobile OTP) session is CUSTOMER even for a
/// seller-owner or admin account, so an SMS code can never open a management
/// API; panel logins (email + password) are FULL and carry the account's role.
enum SessionScope {
  FULL
  CUSTOMER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReferralStatus {
  REGISTERED
  FIRST_ORDER_PENDING
  COMPLETED
  REWARD_ISSUED
}

enum CouponOrigin {
  PROMO
  REFERRAL_REWARD
}

// =============================================================================
// Users & access
// =============================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Canonical 10-digit Indian mobile, no country code. Uniqueness is the
  /// business rule ("one account per number") as well as the login lookup.
  mobile       String     @unique @db.VarChar(15)
  fullName     String?    @map("full_name") @db.VarChar(120)
  email        String?    @db.VarChar(160)
  /// Admin/seller login only. Customers authenticate by OTP and have no
  /// password.
  passwordHash String?    @map("password_hash") @db.VarChar(120)
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  /// Set by an admin to bar this customer from Cash on Delivery.
  codBlocked Boolean @default(false) @map("cod_blocked")

  /// When the mobile number was last proven by a successful OTP verification.
  mobileVerifiedAt DateTime? @map("mobile_verified_at") @db.Timestamptz(3)

  referralCode     String? @unique @map("referral_code") @db.VarChar(16)
  referredByUserId String? @map("referred_by_user_id") @db.Uuid

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Soft delete. Anonymisation of PII happens in the same operation
  /// (PRD §2.2 M3 — Play Store requires a working account-deletion path).
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  referredBy    User?  @relation("UserReferral", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referredUsers User[] @relation("UserReferral")

  referralsMade     Referral[] @relation("ReferralsMade")
  referralsReceived Referral?  @relation("ReferralsReceived")
  issuedCoupons     Coupon[]   @relation("IssuedCoupons")

  addresses          Address[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  carts              Cart[]
  orders             Order[]
  notifications      Notification[]
  deviceTokens       DeviceToken[]
  couponRedemptions  CouponRedemption[]
  stockLedgerEntries StockLedger[]
  statusChanges      OrderStatusHistory[]
  idempotencyKeys    IdempotencyKey[]
  backInStockSubs    BackInStockSubscription[]
  auditLogs          AuditLog[]
  deliveryAgent      DeliveryAgent?
  configUpdates      Configuration[]

  /// Not a single `sellerId` on User — deliberately a join table (see
  /// SellerStaff's own doc comment) so a user can staff more than one seller
  /// and every seller-scoped authorization check has one place to start.
  sellerStaff              SellerStaff[]
  sellerOrderStatusChanges SellerOrderStatusHistory[] @relation("SellerOrderStatusActor")
  approvalBatchesSubmitted ProductApprovalBatch[]     @relation("ApprovalBatchSubmitted")
  approvalBatchesReviewed  ProductApprovalBatch[]     @relation("ApprovalBatchReviewed")
  verifiedSellerDocuments  SellerDocument[]
  deliveryTasksAssigned    DeliveryTask[]             @relation("DeliveryTaskAssignedBy")
  productImports           ProductImport[]

  // Indexes for this table are partial and live in the hardening migration:
  //   users_email_unique   UNIQUE (lower(email)) WHERE email IS NOT NULL
  //   users_staff_roles    (role)                WHERE role <> 'CUSTOMER'
  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// SHA-256 of the token. The raw token is never stored, so a database dump
  /// does not hand over live sessions.
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  /// Rotation family. Presenting an already-rotated token revokes the whole
  /// family — the standard defence against a stolen refresh token.
  familyId  String       @map("family_id") @db.Uuid
  /// Kept for the whole family: refresh re-reads the account's role, so the
  /// scope must travel with the session or a customer session would come back
  /// FULL. Least privilege by default; panel logins pass FULL explicitly.
  scope     SessionScope @default(CUSTOMER)

  userAgent String? @map("user_agent") @db.VarChar(400)
  ip        String? @db.VarChar(64)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "log out everywhere" and the expiry sweep.
  @@index([userId, expiresAt])
  /// Family revocation on reuse detection.
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A seller "Forgot Password?" request (auth/password-reset.service.ts).
/// Only the SHA-256 of the emailed token is stored. Single-use (`usedAt`,
/// claimed atomically) and short-lived (`expiresAt`); a newer request
/// invalidates the older unused ones.
model PasswordResetToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  requestedIp String?   @map("requested_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Home / Work / College / Parents Home — free text, as in the mockup.
  label    String  @default("Home") @db.VarChar(30)
  fullName String  @map("full_name") @db.VarChar(120)
  mobile   String  @db.VarChar(15)
  houseNo  String? @map("house_no") @db.VarChar(80)
  street   String? @db.VarChar(160)
  /// Village / area — mandatory, because in this market it is often the only
  /// part of the address that exists.
  area     String  @db.VarChar(160)
  city     String  @db.VarChar(80)
  state    String  @db.VarChar(80)
  pincode  String  @db.VarChar(6)
  /// First-class field: the rider navigates by landmark, not by street number.
  landmark String? @db.VarChar(160)

  latitude  Float
  longitude Float

  isDefault Boolean @default(false) @map("is_default")

  /// Cached serviceability, refreshed on save. The server always re-checks
  /// at checkout regardless — this exists to render the address list without
  /// N distance calculations.
  isServiceable Boolean @default(true) @map("is_serviceable")
  distanceKm    Float?  @map("distance_km")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  // Partial indexes in the hardening migration:
  //   addresses_user_active         (user_id) WHERE deleted_at IS NULL
  //   addresses_one_default_per_user UNIQUE (user_id)
  //                                  WHERE is_default AND deleted_at IS NULL
  @@map("addresses")
}

// =============================================================================
// Seller (V1: Store) — a marketplace partner. AdiOne's own Grocery is one row
// here (`isPlatformOwned = true`), not a special case.
// =============================================================================

model Seller {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  code String @unique @db.VarChar(40)

  sellerType      SellerType @default(OTHER) @map("seller_type")
  /// AdiOne's own Grocery seller. Flips business rules that only apply to
  /// the platform's own store (e.g. always active regardless of onboarding
  /// state) rather than the schema special-casing "the" store by id.
  isPlatformOwned Boolean    @default(false) @map("is_platform_owned")

  addressLine String  @map("address_line") @db.VarChar(300)
  city        String  @db.VarChar(80)
  state       String  @db.VarChar(80)
  pincode     String  @db.VarChar(6)
  latitude    Float
  longitude   Float
  phone       String? @db.VarChar(15)

  /// Opening hours are evaluated in THIS timezone, never server UTC.
  timezone String @default("Asia/Kolkata") @db.VarChar(60)

  isActive          Boolean   @default(true) @map("is_active")
  /// The SELLER's own "Store Open / Store Closed" switch — distinct from
  /// `isActive` (admin-controlled) and from onboarding approval. OFF closes
  /// the seller to customers immediately and indefinitely, overriding its
  /// weekly hours; nothing ever turns it back ON automatically — only the
  /// seller (or admin acting for them) does. ON hands control back to
  /// SellerHours/SellerClosure. See seller.service.ts's
  /// `evaluateSellerAvailability` for the full priority order.
  isAcceptingOrders Boolean   @default(true) @map("is_accepting_orders")
  /// Seller-level COD policy — the outermost level of the resolution chain.
  allowCod          CodPolicy @default(ALLOW) @map("allow_cod")

  /// Admin onboarding review gate (see SellerProfile/SellerBankDetail/
  /// SellerDocument for the underlying submitted details). A seller cannot
  /// go live while this is not APPROVED, even if `isActive` is set.
  /// Platform-owned sellers are seeded as APPROVED — they never went through
  /// the external onboarding flow.
  onboardingStatus ApprovalStatus @default(PENDING) @map("onboarding_status")

  /// Where the seller is in the two-gate lifecycle (see SellerLifecycleStatus).
  /// `onboardingStatus` is kept in step with it — APPROVED exactly when this
  /// is ACTIVE, REJECTED when ONBOARDING_REJECTED, else PENDING (CHECK
  /// `sellers_lifecycle_matches_onboarding`) — so every existing "is this
  /// seller live" rule keeps reading `onboardingStatus` unchanged. Defaults
  /// to APPLICATION_PENDING so a row created without a decision is never
  /// operational.
  lifecycleStatus        SellerLifecycleStatus @default(APPLICATION_PENDING) @map("lifecycle_status")
  /// The seller-facing reason for the latest Gate 1 rejection, request for
  /// changes or final rejection. Cleared when the seller moves on.
  lifecycleReason        String?               @map("lifecycle_reason") @db.VarChar(500)
  lifecycleUpdatedAt     DateTime?             @map("lifecycle_updated_at") @db.Timestamptz(3)
  /// Self-signup time; null for sellers created by admin.
  applicationSubmittedAt DateTime?             @map("application_submitted_at") @db.Timestamptz(3)
  /// Latest submission for Gate 2 verification.
  onboardingSubmittedAt  DateTime?             @map("onboarding_submitted_at") @db.Timestamptz(3)
  /// Gate 2 approval — when the seller became ACTIVE.
  activatedAt            DateTime?             @map("activated_at") @db.Timestamptz(3)

  /// Fallback commission rate (basis points) when no CommissionRule matches
  /// more specifically — see CommissionRule's own doc comment for the full
  /// precedence chain (product > category > this default).
  defaultCommissionBp Int @default(0) @map("default_commission_bp")

  /// How often this seller is paid out, in plain hours rather than an enum —
  /// "daily" (24), "weekly" (168), "every 15 days" (360) and any future
  /// cadence are all just a number here, no schema change needed to add one.
  settlementCycleHours Int @default(24) @map("settlement_cycle_hours")

  /// Optional per-seller override of MAX_SERVICE_RADIUS_KM. Null = use config.
  maxServiceRadiusKm Float? @map("max_service_radius_km")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile           SellerProfile?
  bankDetail        SellerBankDetail?
  documents         SellerDocument[]
  staff             SellerStaff[]
  restaurantProfile RestaurantProfile?

  hours              SellerHours[]
  closures           SellerClosure[]
  listings           SellerListing[]
  categories         Category[]
  /// Master categories admin has assigned to this seller (see SellerCategory).
  assignedCategories SellerCategory[]
  products           Product[]                 @relation("ProductSubmittedBySeller")
  approvalBatches    ProductApprovalBatch[]
  commissionRules    CommissionRule[]
  sellerOrders       SellerOrder[]
  settlements        SellerSettlement[]
  notifications      Notification[]
  configurations     Configuration[]
  productImports     ProductImport[]
  backInStockSubs    BackInStockSubscription[]

  /// Admin seller list / applications queue filtered by lifecycle stage.
  @@index([lifecycleStatus, createdAt])
  @@map("sellers")
}

model SellerHours {
  id        String  @id @default(uuid()) @db.Uuid
  sellerId  String  @map("seller_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek Int     @map("day_of_week") @db.SmallInt
  /// "HH:mm" local time. Stored as text so a window crossing midnight
  /// (08:00–01:00) stays a plain comparison rather than a date calculation.
  opensAt   String  @map("opens_at") @db.VarChar(5)
  closesAt  String  @map("closes_at") @db.VarChar(5)
  isClosed  Boolean @default(false) @map("is_closed")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, dayOfWeek])
  @@map("seller_hours")
}

/// Holiday / ad-hoc closure (V1: StoreClosure).
model SellerClosure {
  id       String   @id @default(uuid()) @db.Uuid
  sellerId String   @map("seller_id") @db.Uuid
  closedOn DateTime @map("closed_on") @db.Date
  reason   String?  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, closedOn])
  @@map("seller_closures")
}

// =============================================================================
// Seller onboarding — business/legal details a seller fills in after admin
// approves its application (Gate 1), and admin verifies before the seller
// goes ACTIVE (Gate 2). See Seller.lifecycleStatus.
// =============================================================================

/// Business/legal identity. PAN/Aadhaar/GST/FSSAI numbers are sensitive PII —
/// application-layer encryption-at-rest is expected on these columns; the
/// schema only fixes their shape and nullability (GST/FSSAI are optional —
/// not every seller needs them; FSSAI in particular is food-only).
model SellerProfile {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @unique @map("seller_id") @db.Uuid

  businessName String  @map("business_name") @db.VarChar(160)
  businessType String? @map("business_type") @db.VarChar(80)

  ownerFullName String  @map("owner_full_name") @db.VarChar(120)
  ownerMobile   String  @map("owner_mobile") @db.VarChar(15)
  ownerEmail    String? @map("owner_email") @db.VarChar(160)

  panNumber     String? @map("pan_number") @db.VarChar(20)
  aadhaarNumber String? @map("aadhaar_number") @db.VarChar(20)
  /// Required for a registered business above the GST threshold; optional
  /// otherwise (small/unregistered sellers).
  gstNumber     String? @map("gst_number") @db.VarChar(20)
  /// Food sellers/restaurants only.
  fssaiNumber   String? @map("fssai_number") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

/// One current payout account per seller. `isVerified` gates settlement —
/// see SellerSettlement.
model SellerBankDetail {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @unique @map("seller_id") @db.Uuid

  accountHolderName String  @map("account_holder_name") @db.VarChar(120)
  accountNumber     String  @map("account_number") @db.VarChar(40)
  ifscCode          String  @map("ifsc_code") @db.VarChar(11)
  bankName          String? @map("bank_name") @db.VarChar(120)

  isVerified Boolean @default(false) @map("is_verified")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_bank_details")
}

/// License/registration documents a seller must provide — GST certificate,
/// FSSAI license (food), PAN/Aadhaar, business license, bank proof, etc.
/// Many per seller (one row per document, re-uploadable on expiry/rejection).
model SellerDocument {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @map("seller_id") @db.Uuid

  type           SellerDocumentType
  /// The number printed on the document (PAN, Aadhaar, GSTIN, FSSAI…),
  /// normalised. Verification data, not a secret: masked in every read
  /// except an audited admin reveal; never written to logs or audit rows.
  documentNumber String?            @map("document_number") @db.VarChar(40)
  /// Private storage key of the uploaded PDF (never a public URL) —
  /// read only through the authorised document endpoints.
  fileKey        String?            @map("file_key") @db.VarChar(300)
  /// The uploader's file name, sanitised, for display/download only.
  fileName       String?            @map("file_name") @db.VarChar(160)
  fileSize       Int?               @map("file_size")
  contentType    String?            @map("content_type") @db.VarChar(80)
  /// LEGACY: an external link from before direct uploads. Kept on old rows;
  /// never written by new uploads. Every row has a file_key or a file_url
  /// (CHECK constraint in the v2_seller_document_uploads migration).
  fileUrl        String?            @map("file_url") @db.VarChar(500)

  status           DocumentStatus @default(PENDING)
  verifiedByUserId String?        @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?      @map("verified_at") @db.Timestamptz(3)
  rejectionReason  String?        @map("rejection_reason") @db.VarChar(300)

  /// Null for documents with no expiry (e.g. PAN). Set for licenses that
  /// need periodic renewal (GST/FSSAI) — the admin panel's expiry-alert
  /// query filters on this.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  verifiedBy User?  @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  /// Seller's own document checklist.
  @@index([sellerId, type])
  /// Expiry-alert sweep and the admin review queue.
  @@index([status, expiresAt])
  @@map("seller_documents")
}

/// Food/restaurant-only extension of Seller. Everything else a restaurant
/// needs (location, hours, closures, menu categories/items) reuses the
/// generic Seller/Category/Product/SellerListing architecture as-is — this
/// table only holds what's genuinely restaurant-specific.
model RestaurantProfile {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @unique @map("seller_id") @db.Uuid

  cuisine     String[] @map("cuisine")
  isVegOnly   Boolean  @default(false) @map("is_veg_only")
  avgPrepMins Int?     @map("avg_prep_mins")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("restaurant_profiles")
}

/// Which user(s) can act as which seller, and with what role. Deliberately a
/// join table rather than a single `sellerId` column on User — a user can
/// staff more than one seller over time (reassignment, or a multi-store
/// owner later) without a User row migration, and EVERY seller-scoped
/// authorization check in the app starts by looking a user up here (#27:
/// "seller only accesses its own data" is enforced by joining through this
/// table, not by trusting a client-supplied sellerId).
model SellerStaff {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @map("seller_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  role SellerStaffRole @default(STAFF)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  /// "Which seller(s) can this logged-in user act as" — the auth middleware's
  /// own query, run on every seller-panel request.
  @@index([userId])
  @@map("seller_staff")
}

// =============================================================================
// Catalog — Product/ProductVariant/ProductImage stay the shared, seller-
// agnostic master catalog (deviation D3, PRD §8.4). SellerListing (V1:
// StoreVariant) is where a specific seller's price/stock lives.
// =============================================================================

/// Self-referencing category tree (deviation D2, PRD §8.3).
///
/// depth 0  = "Category"    (Grocery, Vegetables, Dairy — the Home row)
/// depth 1  = "Subcategory" (Atta Rice & Dal, Oil & Ghee — the sidebar)
/// depth 2+ = available free of charge when Café or Pharmacy needs it.
///
/// A restaurant's "menu categories" (starters, mains, desserts) are just
/// Category rows scoped to that seller — no separate menu-category model.
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  /// Null = shared taxonomy (grocery-wide categories every grocery seller's
  /// products can attach under). Non-null = scoped to one seller — the
  /// normal case for a restaurant's own menu sections.
  sellerId String? @map("seller_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  name     String  @db.VarChar(120)
  nameHi   String? @map("name_hi") @db.VarChar(120)
  slug     String  @db.VarChar(140)
  imageUrl String? @map("image_url") @db.VarChar(500)

  /// Materialised path, e.g. "grocery/atta-rice-dal". Makes "everything under
  /// Grocery" an indexed prefix scan instead of a recursive CTE.
  path  String @db.VarChar(600)
  depth Int    @default(0) @db.SmallInt

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  /// Vertical-specific behaviour branches on THIS, never on a category name.
  vertical CatalogVertical @default(GROCERY)
  allowCod CodPolicy       @default(INHERIT) @map("allow_cod")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  seller            Seller?          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  parent            Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]       @relation("CategoryTree")
  products          Product[]
  commissionRules   CommissionRule[]
  sellerAssignments SellerCategory[]

  // Slug uniqueness lives ONLY in partial unique indexes (v2_hardening
  // migration) — Prisma can't express them, and a plain @@unique([parentId,
  // slug]) here would count soft-deleted rows (so a deleted subcategory's name
  // could never be reused) and would be recreated by Prisma over the partial
  // one (docs/02-decisions.md D10):
  //   categories_parent_id_slug_key          (parent_id, slug) live, non-root
  //   categories_root_slug_unique_shared     (slug) live roots, shared taxonomy
  //   categories_root_slug_unique_per_seller (seller_id, slug) live roots per seller
  /// "All products under Grocery" prefix query.
  @@index([path])
  // categories_active_tree (parent_id, display_order) WHERE is_active AND
  // deleted_at IS NULL — hardening migration, partial.
  @@map("categories")
}

/// A MASTER category (shared taxonomy root: `sellerId` null, `parentId` null)
/// that admin has assigned to a seller. The seller may create products and
/// its own subcategories only under its assigned master categories (see
/// catalog/seller-category.service.ts). Restaurants don't use this — their
/// menu sections are their own root categories.
model SellerCategory {
  id               String   @id @default(uuid()) @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  /// The admin who assigned it; null for rows the migration backfilled.
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([sellerId, categoryId])
  @@index([categoryId])
  @@map("seller_categories")
}

model Brand {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(120)
  slug     String  @unique @db.VarChar(140)
  logoUrl  String? @map("logo_url") @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  /// Product search: typo-tolerant brand match (`term <% brand`, pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "brands_name_trgm_idx", type: Gin)
  @@map("brands")
}

model Product {
  id         String  @id @default(uuid()) @db.Uuid
  /// Products attach to a LEAF category.
  categoryId String  @map("category_id") @db.Uuid
  brandId    String? @map("brand_id") @db.Uuid

  name          String  @db.VarChar(200)
  nameHi        String? @map("name_hi") @db.VarChar(200)
  slug          String  @db.VarChar(220)
  description   String? @db.Text
  descriptionHi String? @map("description_hi") @db.Text

  /// Local and colloquial names so search finds "cheeni" -> Sugar,
  /// "namak" -> Salt, "doodh" -> Milk.
  searchKeywords String[] @map("search_keywords")

  /// GST rate in basis points (5% = 500). Prices are tax-INCLUSIVE, so this is
  /// used to EXTRACT the tax component for display, never to add tax on top.
  taxRateBp Int     @default(0) @map("tax_rate_bp")
  hsnCode   String? @map("hsn_code") @db.VarChar(20)

  allowCod CodPolicy     @default(INHERIT) @map("allow_cod")
  status   ProductStatus @default(DRAFT)

  /// Admin catalog-approval outcome (#9) — see ProductApprovalBatch/Item for
  /// the full audit trail. This is a denormalized "current decision" cache
  /// (same pattern as Address.isServiceable), kept in sync whenever a batch
  /// item is decided; the batch/item rows remain the source of truth.
  /// Products admin creates directly (notably for the platform-owned
  /// grocery seller) are seeded APPROVED with no batch at all.
  approvalStatus      ApprovalStatus @default(PENDING) @map("approval_status")
  /// The seller who submitted this product for the shared catalog. Null for
  /// products admin created directly.
  submittedBySellerId String?        @map("submitted_by_seller_id") @db.Uuid

  /// Vertical-specific display attributes: shelf life, storage, country of
  /// origin (grocery); prescription_required (pharmacy); crust/toppings
  /// (café); spice_level (a restaurant menu item). The core order pipeline
  /// never reads this.
  attributes Json @default("{}")

  /// Optional OPTION GROUPS (generic — Size, Portion, Color, Storage, Pack
  /// Size…), in display order: [{ "name": "Size", "values": ["Half", "Full"] }].
  /// Empty = a simple item with one variant. Each sellable combination is a
  /// ProductVariant whose `optionValues` picks one value per group.
  optionGroups Json @default("[]") @map("option_groups")

  /// Full-text search document: name + Hindi name (weight A), search_keywords
  /// (B), description (D), 'simple' config. Maintained ONLY by the
  /// `products_search_vector_trigger` DB trigger (v2_product_search
  /// migration) — never written by the application, and not readable through
  /// Prisma Client. Declared here so the schema describes the real table and
  /// no future migration ever drops it.
  searchVector Unsupported("tsvector")? @map("search_vector")

  /// Merchandising ranks for the Home rails. Maintained by admin/report jobs,
  /// not computed per request.
  popularityScore  Int     @default(0) @map("popularity_score")
  isDailyEssential Boolean @default(false) @map("is_daily_essential")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  category           Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand              Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  submittedBySeller  Seller?                    @relation("ProductSubmittedBySeller", fields: [submittedBySellerId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  images             ProductImage[]
  approvalBatchItems ProductApprovalBatchItem[]
  commissionRules    CommissionRule[]

  /// Category listing, in filter order.
  @@index([categoryId, status])
  /// "Recently Added" rail.
  @@index([createdAt])
  /// "Popular Products" / "Best Sellers" rails.
  @@index([popularityScore])
  /// Admin catalog-approval queue.
  @@index([approvalStatus, createdAt])
  /// Seller Panel product list / admin "products of this seller" — without it
  /// every seller's own-catalogue query scans every seller's products.
  @@index([submittedBySellerId])
  /// Product search: full-text match (`search_vector @@ tsquery`).
  @@index([searchVector], map: "products_search_vector_idx", type: Gin)
  /// Product search: typo-tolerant name match (`term <% name`, pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], map: "products_name_trgm_idx", type: Gin)
  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  sku         String   @unique @db.VarChar(60)
  /// Display label: "1 kg", "500 ml", "Pack of 6".
  variantName String   @map("variant_name") @db.VarChar(80)
  unit        UnitType @default(PIECE)
  unitValue   Float    @default(1) @map("unit_value")
  barcode     String?  @db.VarChar(60)

  imageUrl     String? @map("image_url") @db.VarChar(500)
  isDefault    Boolean @default(false) @map("is_default")
  displayOrder Int     @default(0) @map("display_order")

  allowCod CodPolicy     @default(INHERIT) @map("allow_cod")
  status   ProductStatus @default(ACTIVE)

  /// This variant's values for the product's option groups, e.g.
  /// { "Size": "Large", "Color": "Black" }; {} for a simple item.
  optionValues   Json           @default("{}") @map("option_values")
  /// Per-variant review. A variant added to an ALREADY-APPROVED product
  /// starts PENDING (and status DRAFT, so every existing "variant ACTIVE"
  /// gate keeps it hidden) and goes through the normal approval batch; the
  /// product and its approved variants stay live meanwhile. Variants of a
  /// not-yet-approved product are reviewed with the product itself.
  approvalStatus ApprovalStatus @default(APPROVED) @map("approval_status")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerListings SellerListing[]
  orderItems     OrderItem[]
  images         ProductImage[]

  // Variant names are unique among a product's LIVE variants only (partial
  // unique index "product_variants_live_name_unique", migration
  // v2_product_option_variants — Prisma can't express it), so a removed
  // variant's name can be used again.
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid

  /// Three renditions, chosen by the component so a phone on 3G never pulls a
  /// full-size image into a 96px grid tile.
  url      String  @db.VarChar(500)
  thumbUrl String? @map("thumb_url") @db.VarChar(500)
  cardUrl  String? @map("card_url") @db.VarChar(500)
  altText  String? @map("alt_text") @db.VarChar(200)

  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

/// V1: StoreVariant. The sellable unit — one row answers "can THIS SELLER's
/// customer buy this variant right now, and for how much?" Price and stock
/// are seller-scoped, change together and are always read together.
///
/// The same ProductVariant can have many SellerListing rows — one per seller
/// who chooses to sell it, each with its own price/stock — this is what
/// makes "the same product sold by multiple sellers" (#10) real.
model SellerListing {
  id        String @id @default(uuid()) @db.Uuid
  sellerId  String @map("seller_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  /// Paise. CHECK (price_paise <= mrp_paise) in the hardening migration.
  mrpPaise   Int @map("mrp_paise")
  /// Seller-controlled. Admin does not normally edit this (#11).
  pricePaise Int @map("price_paise")

  /// Physical stock on the shelf.
  stockQty    Int @default(0) @map("stock_qty")
  /// Held for orders awaiting payment. available = stockQty - reservedQty.
  reservedQty Int @default(0) @map("reserved_qty")

  lowStockThreshold Int     @default(5) @map("low_stock_threshold")
  maxQtyPerOrder    Int     @default(10) @map("max_qty_per_order")
  isAvailable       Boolean @default(true) @map("is_available")
  /// false = a made-to-order FOOD menu item (restaurant/cafe): no stock count.
  /// Availability is `isAvailable` alone; stockQty holds a fixed capacity that
  /// orders reserve against but never use up (inventory.service skips the
  /// commit/restock arithmetic for these rows).
  tracksStock       Boolean @default(true) @map("tracks_stock")

  allowCod CodPolicy @default(INHERIT) @map("allow_cod")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller          Seller                    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  variant         ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ledger          StockLedger[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  backInStockSubs BackInStockSubscription[]

  /// THE order-creation lock query:
  ///   SELECT … WHERE (seller_id, variant_id) IN (…) ORDER BY variant_id FOR UPDATE
  /// Deterministic ordering on this key is what prevents deadlocks between
  /// concurrent checkouts. Also the natural key.
  @@unique([sellerId, variantId])
  /// Product hydration (catalog.repository.ts PRODUCT_INCLUDE): every product
  /// card loads its variants' offers by `variant_id IN (…)` with no seller id,
  /// which the (seller_id, variant_id) key above cannot serve.
  @@index([variantId])
  // Partial indexes in the hardening migration — out-of-stock rows are absent
  // from the in-stock index entirely:
  //   seller_listings_in_stock  (seller_id)
  //     WHERE is_available AND (stock_qty - reserved_qty) > 0
  //   seller_listings_low_stock (seller_id, stock_qty)
  //     WHERE (stock_qty - reserved_qty) <= low_stock_threshold
  @@map("seller_listings")
}

/// Append-only audit of every stock movement. Without this, a discrepancy
/// between the shelf and the system is unexplainable (PRD §20 R8).
model StockLedger {
  id              String            @id @default(uuid()) @db.Uuid
  sellerListingId String            @map("seller_listing_id") @db.Uuid
  /// Signed. Negative for reservations and sales, positive for restocks.
  delta           Int
  reason          StockLedgerReason
  /// stock_qty after applying this movement — makes the ledger self-checking.
  balanceAfter    Int               @map("balance_after")

  /// The seller-order that caused this movement — precise enough that a
  /// single seller's cancellation restocks only that seller's committed
  /// items, never the whole parent order's.
  sellerOrderId String? @map("seller_order_id") @db.Uuid
  actorUserId   String? @map("actor_user_id") @db.Uuid
  note          String? @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerListing SellerListing @relation(fields: [sellerListingId], references: [id], onDelete: Cascade)
  sellerOrder   SellerOrder?  @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Per-item stock history in the seller/admin panel.
  @@index([sellerListingId, createdAt])
  @@index([sellerOrderId])
  @@map("stock_ledger")
}

// =============================================================================
// Commission — resolved most-specific-wins, same shape as the CodPolicy
// INHERIT chain: product > category > seller default.
// =============================================================================

/// Commission owed to AdiOne on a sale. `Seller.defaultCommissionBp` is the
/// fallback; a row here overrides it at the category or product level.
/// "Category" and "subcategory" both use `categoryId` — the existing
/// Category tree already distinguishes them by depth, so no separate
/// Subcategory FK is needed; the most specific matching category (walking
/// leaf towards root) wins over a less specific one.
///
/// Resolved once at order creation and snapshotted onto SellerOrder
/// (`commissionBp`/`commissionPaise`) — never recomputed later even if this
/// rule subsequently changes, so a past order's payout math stays
/// explainable (same principle as OrderItem's own price snapshot).
model CommissionRule {
  id         String  @id @default(uuid()) @db.Uuid
  sellerId   String  @map("seller_id") @db.Uuid
  /// Null = this rule is not category-scoped.
  categoryId String? @map("category_id") @db.Uuid
  /// Null = this rule is not product-scoped. The most specific level.
  productId  String? @map("product_id") @db.Uuid

  rateBp Int @map("rate_bp")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Resolution precedence: product > category > seller default (handled by
  /// `Seller.defaultCommissionBp`, not a row here). Partial unique indexes
  /// (hardening migration, mirroring addresses_one_default_per_user) enforce
  /// at most one ACTIVE rule per (seller, product) and per (seller,
  /// category) — Prisma can't express a NULLS-aware partial unique here.
  @@index([sellerId, categoryId, productId])
  @@map("commission_rules")
}

// =============================================================================
// Catalog approval — a seller's submitted products are reviewed by admin in
// batches (#9), with full audit history of who submitted/reviewed what.
// =============================================================================

model ProductApprovalBatch {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @map("seller_id") @db.Uuid

  status ApprovalStatus @default(PENDING)

  submittedByUserId String   @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?   @map("review_note") @db.VarChar(400)

  seller      Seller                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  submittedBy User                       @relation("ApprovalBatchSubmitted", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy  User?                      @relation("ApprovalBatchReviewed", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  items       ProductApprovalBatchItem[]

  /// Seller's own "my submissions" list.
  @@index([sellerId, status])
  /// Admin's review queue, oldest-first.
  @@index([status, submittedAt])
  @@map("product_approval_batches")
}

model ProductApprovalBatchItem {
  id        String @id @default(uuid()) @db.Uuid
  batchId   String @map("batch_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Independent per product — admin can approve most of a batch while
  /// rejecting one item, rather than an all-or-nothing decision.
  status     ApprovalStatus @default(PENDING)
  reviewNote String?        @map("review_note") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  batch   ProductApprovalBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([batchId, productId])
  @@index([productId])
  @@map("product_approval_batch_items")
}

// =============================================================================
// Cart — seller-agnostic. One cart per user can mix listings from any number
// of sellers; each line knows its own seller through its SellerListing.
// =============================================================================

model Cart {
  id     String     @id @default(uuid()) @db.Uuid
  userId String     @map("user_id") @db.Uuid
  status CartStatus @default(ACTIVE)

  /// Applied coupon code. Re-validated inside the order transaction; never
  /// trusted from here at checkout time.
  couponCode String? @map("coupon_code") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  /// One ACTIVE cart per user — no longer per seller/store, since a single
  /// cart now mixes products from any number of sellers (#13). Enforced by a
  /// partial unique index in the hardening migration.
  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id              String @id @default(uuid()) @db.Uuid
  cartId          String @map("cart_id") @db.Uuid
  /// The specific seller's listing, not just the master variant — this is
  /// what makes the seller for each line derivable per-item instead of
  /// per-cart (#5), and lets two different sellers' listings of the same
  /// master variant coexist as separate lines if the customer somehow has
  /// both.
  sellerListingId String @map("seller_listing_id") @db.Uuid
  qty             Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart          Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sellerListing SellerListing @relation(fields: [sellerListingId], references: [id], onDelete: Cascade)

  /// NOTE: there is deliberately NO price column here. Price is always
  /// resolved live from seller_listings — the "never trust client totals"
  /// rule expressed as schema.
  @@unique([cartId, sellerListingId])
  @@map("cart_items")
}

// =============================================================================
// Coupons
// =============================================================================

model Coupon {
  id          String     @id @default(uuid()) @db.Uuid
  /// Stored uppercase; the service uppercases on lookup.
  code        String     @unique @db.VarChar(40)
  description String?    @db.VarChar(200)
  type        CouponType

  /// PERCENT: whole percent (15 = 15%). FLAT: paise. FREE_DELIVERY: ignored.
  discountValue    Int  @map("discount_value")
  maxDiscountPaise Int? @map("max_discount_paise")
  minOrderPaise    Int  @default(0) @map("min_order_paise")

  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)

  usageLimitTotal   Int? @map("usage_limit_total")
  usageLimitPerUser Int  @default(1) @map("usage_limit_per_user")
  usedCount         Int  @default(0) @map("used_count")

  isActive Boolean @default(true) @map("is_active")

  /// Null for global promo codes; set for a coupon minted FOR one specific
  /// user (e.g. a ₹50 Refer & Earn reward).
  issuedToUserId      String?      @map("issued_to_user_id") @db.Uuid
  /// Back-link to the Referral that earned this coupon.
  issuedForReferralId String?      @unique @map("issued_for_referral_id") @db.Uuid
  origin              CouponOrigin @default(PROMO)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  issuedToUser      User?     @relation("IssuedCoupons", fields: [issuedToUserId], references: [id], onDelete: Cascade)
  issuedForReferral Referral? @relation(fields: [issuedForReferralId], references: [id], onDelete: SetNull)

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, validTo])
  @@index([issuedToUserId])
  @@map("coupons")
}

// =============================================================================
// Referrals (Refer & Earn)
// =============================================================================

model Referral {
  id             String @id @default(uuid()) @db.Uuid
  referrerUserId String @map("referrer_user_id") @db.Uuid
  /// `@unique` — a user can be referred exactly once, enforced at the DB
  /// level, not just checked in application code.
  referredUserId String @unique @map("referred_user_id") @db.Uuid
  referralCode   String @map("referral_code") @db.VarChar(16)

  status ReferralStatus @default(REGISTERED)

  firstEligibleOrderId String?   @map("first_eligible_order_id") @db.Uuid
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  rewardIssuedAt       DateTime? @map("reward_issued_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  referrer     User    @relation("ReferralsMade", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred     User    @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
  rewardCoupon Coupon?

  @@index([referrerUserId])
  @@map("referrals")
}

model CouponRedemption {
  id            String @id @default(uuid()) @db.Uuid
  couponId      String @map("coupon_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid
  orderId       String @map("order_id") @db.Uuid
  discountPaise Int    @map("discount_paise")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// =============================================================================
// Orders — Parent Order (customer-facing) + SellerOrder (per-seller). See the
// file header's point 8 for the reasoning.
// =============================================================================

model Order {
  id          String @id @default(uuid()) @db.Uuid
  /// Customer-facing id: "AD" + YYMMDD + 6 unambiguous chars.
  orderNumber String @unique @map("order_number") @db.VarChar(24)

  userId    String  @map("user_id") @db.Uuid
  addressId String? @map("address_id") @db.Uuid

  status        OrderStatus        @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  paymentStatus OrderPaymentStatus @default(PENDING) @map("payment_status")

  // --- money — the ORIGINAL checkout snapshot, immutable ------------------
  // Every field in this block is written once at creation and never
  // rewritten, matching this schema's "orders are immutable snapshots" rule.
  itemsSubtotalPaise  Int     @map("items_subtotal_paise")
  itemDiscountPaise   Int     @default(0) @map("item_discount_paise")
  couponId            String? @map("coupon_id") @db.Uuid
  couponCode          String? @map("coupon_code") @db.VarChar(40)
  couponDiscountPaise Int     @default(0) @map("coupon_discount_paise")
  deliveryFeePaise    Int     @default(0) @map("delivery_fee_paise")
  platformFeePaise    Int     @default(0) @map("platform_fee_paise")
  /// Tax contained WITHIN the item prices, extracted for the receipt.
  taxPaise            Int     @default(0) @map("tax_paise")
  /// The amount the customer agreed to pay at checkout. Frozen forever —
  /// this is the receipt figure, not what's still owed.
  totalPaise          Int     @map("total_paise")

  /// THE ONE MUTABLE MONEY FIELD ON ORDER. Starts equal to `totalPaise`;
  /// decreases whenever a SellerOrder is cancelled/rejected (#18/#20), by
  /// that seller order's own tax-inclusive subtotalPaise, so COD collection
  /// at the door and any partial-refund calculation always reflect what's
  /// actually still being delivered — never the original snapshot above.
  currentPayablePaise Int @map("current_payable_paise")

  // --- immutable delivery address snapshot --------------------------------
  deliveryFullName    String  @map("delivery_full_name") @db.VarChar(120)
  deliveryMobile      String  @map("delivery_mobile") @db.VarChar(15)
  deliveryAddressLine String  @map("delivery_address_line") @db.VarChar(500)
  deliveryLandmark    String? @map("delivery_landmark") @db.VarChar(160)
  deliveryCity        String  @map("delivery_city") @db.VarChar(80)
  deliveryState       String  @map("delivery_state") @db.VarChar(80)
  deliveryPincode     String  @map("delivery_pincode") @db.VarChar(6)
  deliveryLatitude    Float   @map("delivery_latitude")
  deliveryLongitude   Float   @map("delivery_longitude")

  distanceKm Float     @map("distance_km")
  etaMinutes Int?      @map("eta_minutes")
  promisedAt DateTime? @map("promised_at") @db.Timestamptz(3)

  /// Hashed 4-digit OTP the customer reads out at the door on COD orders.
  deliveryOtpHash String? @map("delivery_otp_hash") @db.Char(64)

  notes String? @db.VarChar(500)

  // --- parent-level lifecycle timestamps -----------------------------------
  // Per-seller timestamps (accepted/preparing) live on SellerOrder — these
  // are only the stages that happen once, for the whole order.
  placedAt             DateTime? @map("placed_at") @db.Timestamptz(3)
  readyAt              DateTime? @map("ready_at") @db.Timestamptz(3)
  pickedUpAt           DateTime? @map("picked_up_at") @db.Timestamptz(3)
  outForDeliveryAt     DateTime? @map("out_for_delivery_at") @db.Timestamptz(3)
  deliveredAt          DateTime? @map("delivered_at") @db.Timestamptz(3)
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(3)
  /// When an unpaid online order's stock reservation expires.
  reservationExpiresAt DateTime? @map("reservation_expires_at") @db.Timestamptz(3)

  cancellationReason String?      @map("cancellation_reason") @db.VarChar(300)
  cancelledBy        CancelledBy? @map("cancelled_by")

  /// Duplicate-order guard. Unique per (user, key).
  idempotencyKey String? @map("idempotency_key") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  address       Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  sellerOrders  SellerOrder[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  refunds       Refund[]
  deliveryTasks DeliveryTask[]
  notifications Notification[]
  redemptions   CouponRedemption[]

  @@unique([userId, idempotencyKey])
  /// "My Orders", paginated newest first.
  @@index([userId, createdAt])
  /// Admin's cross-seller order view, tabbed by aggregate status.
  @@index([status, createdAt])
  // orders_pending_payment_expiry (reservation_expires_at)
  //   WHERE status = 'PENDING_PAYMENT'  — hardening migration, partial.
  @@map("orders")
}

/// One seller's portion of a parent Order. Owns everything that must move
/// independently of every other seller involved in the same checkout: its
/// own items, its own status lifecycle, its own cancellation/rejection, its
/// own subtotal and its own commission snapshot (#6/#14/#15/#16/#18).
model SellerOrder {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  sellerId String @map("seller_id") @db.Uuid

  status SellerOrderStatus @default(NEW)

  itemsSubtotalPaise Int @default(0) @map("items_subtotal_paise")
  itemDiscountPaise  Int @default(0) @map("item_discount_paise")
  /// This seller's share of the order's tax — extracted so a partial refund
  /// (#19) or COD adjustment (#20) for just this portion is exact.
  taxPaise           Int @default(0) @map("tax_paise")
  /// Sum of this seller's tax-INCLUSIVE line totals (= itemsSubtotalPaise;
  /// taxPaise is extracted from it, never added on top, and itemDiscountPaise
  /// is MRP savings already reflected in the price). What this seller's
  /// portion is worth — the amount `Order.currentPayablePaise` drops by, and
  /// the partial-refund amount, if this SellerOrder is cancelled/rejected.
  subtotalPaise      Int @map("subtotal_paise")

  /// `commissionPaise` is the EXACT sum of this SellerOrder's own
  /// OrderItem.commissionPaise values (the real source of truth — see that
  /// model's own doc comment) — never independently recomputed, so the two
  /// can never drift. `commissionBp` is a DERIVED weighted-average
  /// (commissionPaise / itemsSubtotalPaise) kept only for display; it is
  /// never used in any money calculation.
  commissionBp    Int @map("commission_bp")
  commissionPaise Int @map("commission_paise")

  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  preparingAt DateTime? @map("preparing_at") @db.Timestamptz(3)
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(3)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  rejectionReason    String? @map("rejection_reason") @db.VarChar(300)
  cancellationReason String? @map("cancellation_reason") @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller        Seller                     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory SellerOrderStatusHistory[]
  refunds       Refund[]
  stockLedger   StockLedger[]

  /// THE seller panel query: order tabs, newest first.
  @@index([sellerId, status, createdAt])
  /// Aggregating a parent order's seller portions.
  @@index([orderId])
  @@map("seller_orders")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  sellerOrderId String  @map("seller_order_id") @db.Uuid
  /// Kept for reporting; every displayed field below is a snapshot, so the
  /// order still renders correctly if the variant is later renamed/removed.
  variantId     String? @map("variant_id") @db.Uuid

  productName  String  @map("product_name") @db.VarChar(200)
  variantName  String  @map("variant_name") @db.VarChar(80)
  brandName    String? @map("brand_name") @db.VarChar(120)
  imageUrl     String? @map("image_url") @db.VarChar(500)
  sku          String  @db.VarChar(60)
  unitDisplay  String  @map("unit_display") @db.VarChar(40)
  /// The variant's option picks when ordered ({ "Size": "M", "Color": "Black" };
  /// {} for a simple item) — snapshot, like the name and image above, so a
  /// later edit to the product's variants never changes an old order.
  optionValues Json    @default("{}") @map("option_values")

  qty               Int
  mrpPaise          Int @map("mrp_paise")
  unitPricePaise    Int @map("unit_price_paise")
  lineDiscountPaise Int @default(0) @map("line_discount_paise")
  taxRateBp         Int @default(0) @map("tax_rate_bp")
  taxPaise          Int @default(0) @map("tax_paise")
  lineTotalPaise    Int @map("line_total_paise")

  /// The exact commission rate/amount resolved for THIS line at order
  /// creation (product > category > seller default — see CommissionRule).
  /// THIS is the source of truth for commission, never
  /// `SellerOrder.commissionBp`/`commissionPaise` — those are only a
  /// snapshot SUM/derived-average of these line values, computed once at
  /// creation and never recomputed independently, so the two can never
  /// drift apart.
  commissionBp    Int @default(0) @map("commission_bp")
  commissionPaise Int @default(0) @map("commission_paise")

  /// How COD resolved for THIS line at THIS moment.
  allowCodResolved Boolean @default(true) @map("allow_cod_resolved")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder     SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// The exact listing this line was sold from — set at creation, used to
  /// resolve stock-ledger items precisely on a later cancellation/rejection
  /// (see order-state.service.ts's `loadStockItems`) instead of re-deriving
  /// it from (sellerId, variantId) every time.
  sellerListing   SellerListing?  @relation(fields: [sellerListingId], references: [id], onDelete: SetNull)
  sellerListingId String?         @map("seller_listing_id") @db.Uuid

  @@index([sellerOrderId])
  @@index([sellerListingId])
  @@map("order_items")
}

/// Parent-order-level lifecycle transitions (PENDING_PAYMENT -> ... ->
/// DELIVERED, and the aggregate CANCELLED/PARTIALLY_CANCELLED states).
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")

  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  reason      String?   @db.VarChar(300)
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Tracking timeline.
  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Seller-order-level lifecycle transitions (NEW -> ACCEPTED -> PREPARING ->
/// READY_FOR_PICKUP, or -> REJECTED/CANCELLED). Kept as its own table rather
/// than folded into OrderStatusHistory since the two lifecycles use
/// different enums and a seller's own dashboard should only ever query this
/// one, never the parent's.
model SellerOrderStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  sellerOrderId String             @map("seller_order_id") @db.Uuid
  fromStatus    SellerOrderStatus?
  toStatus      SellerOrderStatus  @map("to_status")

  actorType   ActorType @map("actor_type")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  reason      String?   @db.VarChar(300)
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  actor       User?       @relation("SellerOrderStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Seller-facing tracking timeline.
  @@index([sellerOrderId, createdAt])
  @@map("seller_order_status_history")
}

// =============================================================================
// Payments
// =============================================================================

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  provider          String  @db.VarChar(40)
  providerOrderId   String? @map("provider_order_id") @db.VarChar(120)
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(120)

  method      String? @db.VarChar(40)
  amountPaise Int     @map("amount_paise")
  currency    String  @default("INR") @db.VarChar(3)

  status        PaymentStatus @default(CREATED)
  failureCode   String?       @map("failure_code") @db.VarChar(80)
  failureReason String?       @map("failure_reason") @db.VarChar(300)

  rawPayload Json?

  capturedAt DateTime? @map("captured_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  /// Reconciliation sweep for payments stuck pending.
  @@index([status, createdAt])
  @@map("payments")
}

/// Webhook log and replay guard.
model PaymentEvent {
  id       String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(40)
  eventId  String @map("event_id") @db.VarChar(160)

  eventType      String  @map("event_type") @db.VarChar(80)
  signatureValid Boolean @map("signature_valid")
  payload        Json

  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("payment_events")
}

model Refund {
  id            String  @id @default(uuid()) @db.Uuid
  paymentId     String  @map("payment_id") @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  /// Set when this refund is for one cancelled seller portion rather than
  /// the whole order (#19/#8) — null means a full-order refund.
  sellerOrderId String? @map("seller_order_id") @db.Uuid

  providerRefundId String?      @unique @map("provider_refund_id") @db.VarChar(120)
  amountPaise      Int          @map("amount_paise")
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(300)
  failureReason    String?      @map("failure_reason") @db.VarChar(300)

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([status])
  @@map("refunds")
}

// =============================================================================
// Delivery — AdiOne runs its own fleet (#21), decoupled from any one seller.
// =============================================================================

model DeliveryAgent {
  id     String  @id @default(uuid()) @db.Uuid
  /// Set when a rider gets their own login (delivery app).
  userId String? @unique @map("user_id") @db.Uuid

  name          String  @db.VarChar(120)
  mobile        String  @unique @db.VarChar(15)
  vehicleNumber String? @map("vehicle_number") @db.VarChar(20)

  isActive    Boolean @default(true) @map("is_active")
  isAvailable Boolean @default(true) @map("is_available")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks DeliveryTask[]

  /// Platform-wide fleet lookup — NOT scoped to a seller, deliberately (#11:
  /// "delivery agents must not be permanently tied to one seller").
  @@index([isActive, isAvailable])
  @@map("delivery_agents")
}

/// V1: DeliveryAssignment. One delivery run for a parent Order — today a
/// single pickup+drop-off (the whole order, since delivery only starts once
/// every required SellerOrder is ready), deliberately kept as its own model,
/// decoupled from Order/SellerOrder, so a future multi-stop version (one
/// stop per seller pickup) only ever needs a new child table here — it never
/// has to touch order or seller-order modeling (#11).
model DeliveryTask {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  agentId String @map("agent_id") @db.Uuid

  assignedByUserId String?            @map("assigned_by_user_id") @db.Uuid
  status           DeliveryTaskStatus @default(ASSIGNED)

  /// COD cash actually handed over, recorded at delivery. Must reconcile
  /// against `Order.currentPayablePaise`, not the original `totalPaise`, if
  /// a seller portion was cancelled before delivery (#20).
  cashCollectedPaise Int?    @map("cash_collected_paise")
  notes              String? @db.VarChar(300)

  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  pickedUpAt  DateTime? @map("picked_up_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent      DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Restrict)
  assignedBy User?         @relation("DeliveryTaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  /// "One active rider per order" is a partial unique index (status <>
  /// 'CANCELLED') in the hardening migration.
  @@index([orderId])
  @@index([agentId, status])
  @@map("delivery_tasks")
}

// =============================================================================
// Settlement — seller payouts, on a configurable cycle (Seller.
// settlementCycleHours, default 24h — see that field's own doc comment).
// =============================================================================

model SellerSettlement {
  id       String @id @default(uuid()) @db.Uuid
  sellerId String @map("seller_id") @db.Uuid

  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)

  /// Sum of settled SellerOrders' subtotalPaise for this period.
  grossSalesPaise Int @map("gross_sales_paise")
  /// Sum of their commissionPaise snapshots.
  commissionPaise Int @map("commission_paise")
  /// grossSalesPaise - commissionPaise (before any other deduction).
  netPayablePaise Int @map("net_payable_paise")

  status SettlementStatus @default(PENDING)
  paidAt DateTime?        @map("paid_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  /// Makes a duplicate settlement run for the same period a constraint
  /// violation, not an application-logic bug.
  @@unique([sellerId, periodStart, periodEnd])
  /// Seller's own payout history; admin's pending-payout queue.
  @@index([sellerId, status])
  @@map("seller_settlements")
}

// =============================================================================
// Notifications
// =============================================================================

/// Doubles as the in-app notification feed and the outbox for delivery
/// retries — one row per (user, event, channel).
model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  orderId String? @map("order_id") @db.Uuid

  type    NotificationType
  channel NotificationChannel @default(PUSH)
  title   String              @db.VarChar(160)
  body    String              @db.VarChar(500)
  data    Json?

  status            NotificationStatus @default(QUEUED)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(160)
  failureReason     String?            @map("failure_reason") @db.VarChar(300)
  attempts          Int                @default(0)

  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Feed this row belongs to; SELLER rows also carry the seller they are
  /// about, so a user staffing several sellers sees each seller's feed apart.
  audience  NotificationAudience @default(CUSTOMER)
  sellerId  String?              @map("seller_id") @db.Uuid
  /// Deterministic identity of the business event this row announces
  /// (e.g. "so:<id>:ACCEPTED", "refund:<id>:COMPLETED"). Unique per user, so
  /// a retried or repeated operation cannot notify the same person twice.
  /// Null only for legacy rows written before it existed.
  dedupeKey String?              @map("dedupe_key") @db.VarChar(160)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  /// In-app feeds (per audience) and unread counts.
  @@index([userId, audience, createdAt])
  // notifications_queued (created_at) WHERE status = 'QUEUED' — hardening
  // migration, partial.
  @@map("notifications")
}

model DeviceToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  token      String         @unique @db.VarChar(400)
  platform   DevicePlatform
  appVersion String?        @map("app_version") @db.VarChar(20)
  isActive   Boolean        @default(true) @map("is_active")

  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("device_tokens")
}

/// Mockup's "Notify me" on an out-of-stock listing.
model BackInStockSubscription {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  sellerListingId String @map("seller_listing_id") @db.Uuid
  sellerId        String @map("seller_id") @db.Uuid

  notifiedAt DateTime? @map("notified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerListing SellerListing @relation(fields: [sellerListingId], references: [id], onDelete: Cascade)
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// One open subscription per (user, listing) — partial unique
  /// (notified_at IS NULL) in the hardening migration.
  @@index([sellerListingId, notifiedAt])
  @@index([userId])
  @@map("back_in_stock_subscriptions")
}

// =============================================================================
// Configuration, idempotency, audit
// =============================================================================

/// What tapping a banner does. Mirrors HomeFeedDto.banners[].actionType.
enum BannerActionType {
  NONE
  CATEGORY
  PRODUCT
  COUPON
}

/// Admin-managed banner. `placement` is a free-form slug, not an enum, so a
/// new place to show banners ("home_top", "home_middle", "food",
/// "category:<id>", …) needs no schema change. The image is stored like every
/// other content image: optimised to WebP in public storage (image_url).
model Banner {
  id        String  @id @default(uuid()) @db.Uuid
  placement String  @db.VarChar(60)
  title     String? @db.VarChar(120)
  subtitle  String? @db.VarChar(200)

  imageUrl    String @map("image_url") @db.VarChar(500)
  /// Pixel size of the stored image, so a client can show the whole banner
  /// at its own aspect ratio instead of cropping it.
  imageWidth  Int    @map("image_width")
  imageHeight Int    @map("image_height")

  actionType  BannerActionType @default(NONE) @map("action_type")
  /// Category id, product id or coupon code, by actionType; null for NONE.
  actionValue String?          @map("action_value") @db.VarChar(120)

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// GET /banners?placement=… — active banners of one placement, in order.
  @@index([placement, isActive, displayOrder])
  @@map("banners")
}

/// Business configuration. Every rule an admin might want to change lives
/// here — nothing in the codebase hardcodes any of these values.
/// What a bulk import brings in: product rows (CSV/XLSX, optional image ZIP)
/// or images only, matched to existing products by SKU / barcode.
enum ProductImportKind {
  PRODUCTS
  IMAGES
}

/// CREATE never touches an existing product (an existing SKU is a conflict);
/// UPDATE changes only the non-empty cells of products matched by own SKU.
enum ProductImportMode {
  CREATE
  UPDATE
}

enum ProductImportStatus {
  /// Files received; parsing, validation and image processing run in the background.
  ANALYZING
  /// Preview ready, waiting for the seller to confirm.
  READY
  /// Confirmed; waiting for (or between) processing runs.
  QUEUED
  PROCESSING
  COMPLETED
  /// The file itself could not be used (or analysis was interrupted).
  FAILED
  CANCELLED
  /// A preview nobody confirmed in time.
  EXPIRED
}

enum ProductImportRowStatus {
  /// Valid, imported on confirm.
  READY
  /// Has errors: fix and upload again.
  INVALID
  /// Same SKU / barcode / image as an earlier row of the same file.
  DUPLICATE
  /// Matches an existing product the chosen mode will not touch.
  CONFLICT
  /// Left out by the seller.
  EXCLUDED
  DONE
  /// Valid, but writing it failed; can be retried.
  FAILED
}

enum ProductImportRowAction {
  NONE
  CREATE
  UPDATE
  ATTACH_IMAGES
}

/// One bulk import job (Seller Panel, Products, Bulk Import). Rows and images
/// live in their own tables; this row holds the summary only.
model ProductImport {
  id              String              @id @default(uuid()) @db.Uuid
  sellerId        String              @map("seller_id") @db.Uuid
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  kind            ProductImportKind
  mode            ProductImportMode   @default(CREATE)
  status          ProductImportStatus @default(ANALYZING)

  fileName       String? @map("file_name") @db.VarChar(255)
  archiveName    String? @map("archive_name") @db.VarChar(255)
  /// The file's own header row, in order; the error report repeats it.
  columns        Json    @default("[]")
  /// Header cells that matched no known column, for the preview.
  ignoredColumns Json    @default("[]") @map("ignored_columns")

  totalRows      Int @default(0) @map("total_rows")
  readyRows      Int @default(0) @map("ready_rows")
  invalidRows    Int @default(0) @map("invalid_rows")
  duplicateRows  Int @default(0) @map("duplicate_rows")
  conflictRows   Int @default(0) @map("conflict_rows")
  warningRows    Int @default(0) @map("warning_rows")
  processedRows  Int @default(0) @map("processed_rows")
  createdCount   Int @default(0) @map("created_count")
  updatedCount   Int @default(0) @map("updated_count")
  failedCount    Int @default(0) @map("failed_count")
  skippedCount   Int @default(0) @map("skipped_count")
  imageCount     Int @default(0) @map("image_count")
  /// Archive entries examined so far, for the ANALYZING progress bar.
  analyzedImages Int @default(0) @map("analyzed_images")

  /// Short, seller-safe reason when the whole job failed.
  errorSummary String?   @map("error_summary") @db.VarChar(500)
  /// Liveness of the worker holding the job: a stale one is resumed or failed.
  heartbeatAt  DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows      ProductImportRow[]
  images    ProductImportImage[]

  /// Import history, newest first.
  @@index([sellerId, createdAt])
  /// Worker pick-up and retention sweeps.
  @@index([status, heartbeatAt])
  @@map("product_imports")
}

/// One row of an import file (or one image of an images-only import).
model ProductImportRow {
  id        String                 @id @default(uuid()) @db.Uuid
  importId  String                 @map("import_id") @db.Uuid
  /// Spreadsheet row number as the seller sees it (header = row 1, data from row 2).
  rowNumber Int                    @map("row_number")
  status    ProductImportRowStatus
  action    ProductImportRowAction @default(NONE)

  sku        String? @db.VarChar(60)
  /// The cells as uploaded (header -> text), for the preview and the error report.
  rawValues  Json    @map("raw_values")
  /// Normalised, validated fields (prices in paise): what processing writes.
  parsed     Json    @default("{}")
  /// [{ field, message }]
  errors     Json    @default("[]")
  warnings   Json    @default("[]")
  /// Image file names, primary first.
  imageNames Json    @default("[]") @map("image_names")
  /// The seller's choices on the preview: { excluded, primaryImage, sku, makePrimary }.
  decisions  Json    @default("{}")

  /// The product created, updated or matched.
  productId   String?   @map("product_id") @db.Uuid
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  import ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("product_import_rows")
}

enum ProductImportImageStatus {
  /// Validated and stored as an optimised WebP, ready to attach.
  READY
  /// Not a usable image (unsupported, corrupt, too large).
  INVALID
  /// Two archive entries share this file name: ambiguous, never attached.
  DUPLICATE_NAME
  /// In the archive but no row refers to it.
  UNUSED
}

/// One image file of an import's archive, already through the image pipeline.
model ProductImportImage {
  id        String                   @id @default(uuid()) @db.Uuid
  importId  String                   @map("import_id") @db.Uuid
  /// Base name as in the archive.
  fileName  String                   @map("file_name") @db.VarChar(255)
  /// Lower-cased base name: what rows are matched on.
  nameKey   String                   @map("name_key") @db.VarChar(255)
  status    ProductImportImageStatus
  error     String?                  @db.VarChar(300)
  sha256    String?                  @db.VarChar(64)
  bytes     Int                      @default(0)
  url       String?                  @db.VarChar(500)
  thumbUrl  String?                  @map("thumb_url") @db.VarChar(500)
  width     Int?
  height    Int?
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  import ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, nameKey])
  @@map("product_import_images")
}

model Configuration {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @db.VarChar(80)
  /// Null = global. Non-null = per-seller override.
  sellerId String? @map("seller_id") @db.Uuid

  /// JSON so a value can be a number, a boolean, a string or a structure
  /// such as DELIVERY_FEE_SLABS, without a column per type.
  value       Json
  description String? @db.VarChar(400)
  /// Safe to expose via GET /config/public to the unauthenticated app.
  isPublic    Boolean @default(false) @map("is_public")

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller    Seller? @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([key, sellerId])
  @@index([isPublic])
  @@map("configurations")
}

/// Idempotency records for POST /orders and POST /payments/create.
model IdempotencyKey {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  key    String @db.VarChar(120)

  endpoint    String @db.VarChar(120)
  requestHash String @map("request_hash") @db.Char(64)

  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  resourceId     String?           @map("resource_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  /// Expiry sweep.
  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Who changed what, and what it looked like before. Every admin/seller
/// mutation of price, stock, config, approval or order status writes one row.
model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid

  action     String  @db.VarChar(80)
  entityType String  @map("entity_type") @db.VarChar(60)
  entityId   String? @map("entity_id") @db.VarChar(80)

  before Json?
  after  Json?
  ip     String? @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
