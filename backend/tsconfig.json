{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    // "Node" is the deprecated node10 strategy. Node16/NodeNext would fix
    // the warning but starts enforcing extension/exports-map rules that
    // would break the extensionless relative imports used throughout this
    // backend; "Bundler" isn't correct either since this runs under Node,
    // not a bundler. Silencing (not changing) the deprecation is correct
    // until Node resolution actually needs revisiting.
    "ignoreDeprecations": "5.0",
    "types": ["node"],

    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"]
    },
    

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "prisma", "**/*.test.ts"]
}
