{
  "expo": {
    "name": "AadiOne",
    "slug": "adione",
    "owner": "aadione-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "adione",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-ios.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "in.adione.app",
      "googleServicesFile": "./android/app/google-services.json",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.adione.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AadiOne uses your location to check whether we deliver to your area and to estimate your delivery time."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AadiOne uses your location to check whether we deliver to your area and to estimate your delivery time."
        }
      ],
      "expo-secure-store",
      "./plugins/withGradleNetworkTimeout",
      "./plugins/withUpiQueries",
      "expo-font",
      "expo-image",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/adione-icon.png",
          "color": "#1E8E3E"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.adione.in/api/v1",
      "eas": {
        "projectId": "0b05b661-ca47-4ba2-9654-9b9bbf1ac9c9"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
